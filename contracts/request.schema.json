{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexbonemberger/mainalto-gitsignals-open/blob/main/contracts/request.schema.json",
  "title": "MainAlto GitSignals request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "operation", "chat", "capability", "objective", "model", "expires_utc"],
  "properties": {
    "schema": {"const": "mainalto.gitsignals.request/1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "operation": {"const": "capability.propose"},
    "chat": {"type": "string", "minLength": 1, "maxLength": 100},
    "capability": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"},
    "objective": {"type": "string", "minLength": 8, "maxLength": 1800},
    "model": {"const": "qwen3-vl:2b-instruct"},
    "expires_utc": {"type": "string", "format": "date-time"}
  }
}
